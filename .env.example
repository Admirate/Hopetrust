# =============================================================================
# Hope Trust — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hopetrustindia.com

# ── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919000850001

# ── Google Maps Embed (optional — has default) ───────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# ── Netlify Functions (server-side only) ─────────────────────────────────────
CRM_ENDPOINT=https://your-crm-endpoint.example.com
WHATSAPP_CRM_TOKEN=your-crm-token

# ── Resend (for newsletter scripts, server-side only) ────────────────────────
RESEND_API_KEY=re_your_resend_api_key
