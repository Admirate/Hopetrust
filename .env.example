# ============================================================
# Hope Trust India — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Supabase (public — safe to expose in browser) ───────────────────────────
# These are prefixed NEXT_PUBLIC_ intentionally.
# Security is enforced by Row Level Security (RLS) policies in Supabase,
# NOT by keeping these keys secret. See supabase/migrations/001_rls_policies.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── WhatsApp CRM (server-side only — NEVER prefix with NEXT_PUBLIC_) ─────────
# Used exclusively in: netlify/functions/whatsapp-crm.mjs
# This token is a Bearer secret for the external CRM API.
#
# ROTATION POLICY (rotate every 90 days or immediately on suspected compromise):
#   1. Log in to the CRM dashboard at https://prodcron.askadmissionsone.in
#   2. Generate a new Bearer token for the Hope Trust carrier integration
#   3. Update WHATSAPP_CRM_TOKEN in Netlify Dashboard → Site Settings → Environment Variables
#   4. Trigger a redeploy (Netlify Edge Functions pick up new env vars on next cold start)
#   5. Revoke the old token in the CRM dashboard
#   6. Update the rotation date in your secrets log
#
# Last rotated: YYYY-MM-DD
# Next rotation due: YYYY-MM-DD (90 days from above)
WHATSAPP_CRM_TOKEN=your-crm-bearer-token-here

# ─── Resend (server-side only — dev/scripts use only) ─────────────────────────
# Used exclusively in: scripts/test-newsletter.mjs
# NOT used in the deployed application.
# Obtain from: https://resend.com/api-keys
#
# ROTATION POLICY: Rotate if key is exposed or every 180 days.
#   1. Go to Resend Dashboard → API Keys
#   2. Create a new key with send-only permissions
#   3. Update this value locally and in any CI secrets
#   4. Delete the old key
RESEND_API_KEY=re_your_resend_api_key_here
