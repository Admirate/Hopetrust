# =============================================================================
# Hope Trust — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hopetrustindia.com

# ── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919000850001

# ── Google Maps Embed (optional — has default) ───────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...

# ── Netlify Functions (server-side only) ─────────────────────────────────────
CRM_ENDPOINT=https://your-crm-endpoint.example.com
WHATSAPP_CRM_TOKEN=your-crm-token

# ── Admin Dashboard (server-side only) ────────────────────────────────────────
# Service role key (NOT the anon key) — used by Netlify Functions to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Secret for signing admin JWT tokens (generate with: openssl rand -base64 32)
ADMIN_JWT_SECRET=your-jwt-secret

# ── Resend (for newsletter + enrollment emails, server-side only) ────────────
RESEND_API_KEY=re_your_resend_api_key
# "From" address used by enrollment confirmation + newsletter emails
# Must be a verified Resend domain. Format: "Hope Trust <frontoffice@hopetrustindia.com>"
NEWSLETTER_FROM_EMAIL=Hope Trust <frontoffice@hopetrustindia.com>
# Where new-enrollment admin alerts are delivered (falls back to NEWSLETTER_FROM_EMAIL)
ADMIN_ALERT_EMAIL=frontoffice@hopetrustindia.com

# ── Razorpay (Training + Addiction booking system) ───────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys (use Test Mode keys to start)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook secret from Dashboard > Settings > Webhooks (any strong string you set on Razorpay)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Same key_id exposed to the client so Razorpay Checkout can open in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
